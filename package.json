{
  "name": "@skynote/editor",
  "version": "0.1.0-beta.1",
  "type": "module",
  "description": "SkyNote ready-to-use editor: engine and basic plugins assembled in one class, rendering backend pluggable",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skynote-universe/editor.git"
  },
  "homepage": "https://github.com/skynote-universe/editor#readme",
  "bugs": {
    "url": "https://github.com/skynote-universe/editor/issues"
  },
  "keywords": [
    "whiteboard",
    "infinite-canvas",
    "editor",
    "canvas",
    "diagram"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "test": "vitest run --dir tests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@skynote/core": "workspace:*",
    "@skynote/plugins-basic": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
